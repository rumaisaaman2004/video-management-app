{
  "info": {
    "name": "Video Management App API",
    "description": "Every endpoint of the Video Management App API, with tests.\n\nRun the whole collection in order (Collection Runner, or `npm run test:api`). It signs in as the demo admin and demo user, saves the access token automatically, and deletes everything it creates.\n\nRequirements: the API running (`npm run dev`), the database seeded (`npm run db:seed --workspace=server`) and at least one ready, public video (`npm run seed:media --workspace=server`).\n\nSign-in is rate limited to 10 attempts per 15 minutes; each run uses 2.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "categoryId",
      "value": ""
    },
    {
      "key": "categoryName",
      "value": ""
    },
    {
      "key": "videoId",
      "value": ""
    },
    {
      "key": "renditionPath",
      "value": ""
    },
    {
      "key": "uploadedVideoId",
      "value": ""
    },
    {
      "key": "playlistId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Setup",
      "description": "Checks the API is up and signs in as the demo admin.",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            },
            "header": [],
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('database is up', () => pm.expect(body.data).to.eql({ status: 'ok', database: 'up' }));"
                ]
              }
            }
          ]
        },
        {
          "name": "Sign in as admin",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('signed in as an admin', () => pm.expect(body.data.user.role).to.eql('admin'));",
                  "pm.test('never returns the password hash', () => pm.expect(pm.response.text()).not.to.include('password'));",
                  "pm.collectionVariables.set('accessToken', body.data.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Current user",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            },
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('is the admin', () => pm.expect(body.data.user.email).to.eql(pm.environment.get('adminEmail')));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Categories",
      "description": "Create, update and delete a category (admin).",
      "item": [
        {
          "name": "List categories",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/categories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "categories"]
            },
            "header": [],
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('returns categories with video counts', () => {",
                  "  pm.expect(body.data).to.be.an('array').that.is.not.empty;",
                  "  pm.expect(body.data[0]).to.have.keys('id', 'name', 'slug', 'description', 'videoCount', 'createdAt', 'updatedAt');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create category",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/categories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "categories"]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Test {{$timestamp}}\",\n  \"description\": \"Created by the Postman tests\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('generates a slug from the name', () => pm.expect(body.data.slug).to.match(/^postman-test-\\d+$/));",
                  "pm.collectionVariables.set('categoryId', body.data.id);",
                  "pm.collectionVariables.set('categoryName', body.data.name);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create duplicate category",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/categories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "categories"]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{categoryName}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 409 for a duplicate name', () => pm.response.to.have.status(409));",
                  "const body = pm.response.json();",
                  "pm.test('names the duplicated field', () => pm.expect(body.error.message).to.eql('A category with this name already exists'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update category",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/api/categories/{{categoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "categories", "{{categoryId}}"]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Updated by the Postman tests\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('saves the change', () => pm.expect(body.data.description).to.eql('Updated by the Postman tests'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete category",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/categories/{{categoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "categories", "{{categoryId}}"]
            },
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('responds 204', () => pm.response.to.have.status(204));"]
              }
            }
          ]
        },
        {
          "name": "Get deleted category",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/categories/{{categoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "categories", "{{categoryId}}"]
            },
            "header": [],
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 404', () => pm.response.to.have.status(404));",
                  "const body = pm.response.json();",
                  "pm.test('uses the error format', () => pm.expect(body.error.code).to.eql('NOT_FOUND'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Videos",
      "description": "Library, streaming, upload, edit and delete.",
      "item": [
        {
          "name": "Library (ready, public videos)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/videos?pageSize=5&sort=newest",
              "host": ["{{baseUrl}}"],
              "path": ["api", "videos"],
              "query": [
                {
                  "key": "pageSize",
                  "value": "5"
                },
                {
                  "key": "sort",
                  "value": "newest"
                }
              ]
            },
            "header": [],
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('has at least one video (run seed:media if not)', () => pm.expect(body.meta.total).to.be.above(0));",
                  "pm.test('only ready, public videos', () => body.data.forEach((v) => pm.expect([v.status, v.visibility]).to.eql(['ready', 'public'])));",
                  "pm.test('paging details', () => pm.expect(body.meta).to.include({ page: 1, pageSize: 5 }));",
                  "pm.collectionVariables.set('videoId', body.data[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Search as you type",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/videos?q=intro&sort=relevance",
              "host": ["{{baseUrl}}"],
              "path": ["api", "videos"],
              "query": [
                {
                  "key": "q",
                  "value": "intro"
                },
                {
                  "key": "sort",
                  "value": "relevance"
                }
              ]
            },
            "header": [],
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('every result mentions the search word', () => body.data.forEach((v) =>",
                  "  pm.expect(`${v.title} ${v.description} ${v.tags.join(' ')}`.toLowerCase()).to.include('intro')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Video details",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/videos/{{videoId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "videos", "{{videoId}}"]
            },
            "header": [],
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('lists the quality versions', () => pm.expect(body.data.renditions).to.be.an('array').that.is.not.empty);",
                  "// Saved without the leading slash: Postman adds one between the base URL and the path.",
                  "pm.collectionVariables.set('renditionPath', body.data.renditions[0].url.replace(/^\\//, ''));"
                ]
              }
            }
          ]
        },
        {
          "name": "Stream a range (seeking)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/{{renditionPath}}",
              "host": ["{{baseUrl}}"],
              "path": ["{{renditionPath}}"]
            },
            "header": [
              {
                "key": "Range",
                "value": "bytes=0-1023"
              }
            ],
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 206 Partial Content', () => pm.response.to.have.status(206));",
                  "pm.test('sends exactly the requested bytes', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Range')).to.match(/^bytes 0-1023\\/\\d+$/);",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.eql('video/mp4');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Thumbnail",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/videos/{{videoId}}/thumbnail",
              "host": ["{{baseUrl}}"],
              "path": ["api", "videos", "{{videoId}}", "thumbnail"]
            },
            "header": [],
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));",
                  "pm.test('is a JPEG image', () => pm.expect(pm.response.headers.get('Content-Type')).to.eql('image/jpeg'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Upload a video",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/videos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "videos"]
            },
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "title",
                  "value": "Postman upload {{$timestamp}}",
                  "type": "text"
                },
                {
                  "key": "description",
                  "value": "Uploaded by the Postman tests",
                  "type": "text"
                },
                {
                  "key": "tags",
                  "value": "postman, test",
                  "type": "text"
                },
                {
                  "key": "visibility",
                  "value": "private",
                  "type": "text"
                },
                {
                  "key": "file",
                  "type": "file",
                  "src": "postman/fixtures/sample.mp4"
                }
              ]
            },
            "description": "In the Postman app, choose postman/fixtures/sample.mp4 (or any MP4) for the file field."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 202 Accepted', () => pm.response.to.have.status(202));",
                  "const body = pm.response.json();",
                  "pm.test('is queued for processing', () => pm.expect(body.data.status).to.eql('processing'));",
                  "pm.test('stores tags normalized', () => pm.expect(body.data.tags).to.eql(['postman', 'test']));",
                  "pm.collectionVariables.set('uploadedVideoId', body.data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Edit the uploaded video",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/api/videos/{{uploadedVideoId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "videos", "{{uploadedVideoId}}"]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman upload (edited)\",\n  \"tags\": [\n    \"Postman\",\n    \"postman\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('saves the title and de-duplicates tags', () => {",
                  "  pm.expect(body.data.title).to.eql('Postman upload (edited)');",
                  "  pm.expect(body.data.tags).to.eql(['postman']);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete the uploaded video",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/videos/{{uploadedVideoId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "videos", "{{uploadedVideoId}}"]
            },
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('responds 204', () => pm.response.to.have.status(204));"]
              }
            }
          ]
        },
        {
          "name": "Tags",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/tags",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tags"]
            },
            "header": [],
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('tags with video counts', () => pm.expect(body.data[0]).to.have.keys('name', 'videoCount'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Viewer features",
      "description": "Likes, favourites, progress and history as the demo user. Undone at the end.",
      "item": [
        {
          "name": "Sign in as user",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('signed in as a normal user', () => pm.expect(body.data.user.role).to.eql('user'));",
                  "pm.collectionVariables.set('accessToken', body.data.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Like",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/api/videos/{{videoId}}/like",
              "host": ["{{baseUrl}}"],
              "path": ["api", "videos", "{{videoId}}", "like"]
            },
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('is liked', () => pm.expect(body.data.liked).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Unlike",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/videos/{{videoId}}/like",
              "host": ["{{baseUrl}}"],
              "path": ["api", "videos", "{{videoId}}", "like"]
            },
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('is no longer liked', () => pm.expect(body.data.liked).to.eql(false));"
                ]
              }
            }
          ]
        },
        {
          "name": "Save to favourites",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/api/videos/{{videoId}}/bookmark",
              "host": ["{{baseUrl}}"],
              "path": ["api", "videos", "{{videoId}}", "bookmark"]
            },
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('is saved', () => pm.expect(body.data.bookmarked).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "My favourites",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/me/bookmarks",
              "host": ["{{baseUrl}}"],
              "path": ["api", "me", "bookmarks"]
            },
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('includes the saved video', () => pm.expect(body.data.map((v) => v.id)).to.include(pm.collectionVariables.get('videoId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Remove from favourites",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/videos/{{videoId}}/bookmark",
              "host": ["{{baseUrl}}"],
              "path": ["api", "videos", "{{videoId}}", "bookmark"]
            },
            "header": []
          },
