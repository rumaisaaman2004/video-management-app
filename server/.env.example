# Copy this file to .env and adjust the values for your machine.

NODE_ENV=development
PORT=4000

# postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/video_management_app
DATABASE_POOL_MAX=10

# Origin allowed to call the API from a browser (the React dev server by default)
CORS_ORIGIN=http://localhost:5173

# Optional: silent | error | warn | info | debug (defaults depend on NODE_ENV)
# LOG_LEVEL=debug

# Number of reverse proxies / load balancers in front of the API (0 when running locally)
TRUST_PROXY=0

# Secret used to sign access tokens. At least 32 characters; generate with:
#   openssl rand -hex 32
JWT_SECRET=<generate-a-random-secret>

# Optional overrides (defaults shown)
# JWT_ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL_DAYS=7
# BCRYPT_ROUNDS=12
# AUTH_RATE_LIMIT_MAX=10

# Media storage and processing (defaults shown)
# STORAGE_DIR=uploads
# MAX_UPLOAD_SIZE_MB=500
# VIDEO_PROCESSING_CONCURRENCY=1
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe

# Tests read server/.env.test instead of this file. Create it with:
#   NODE_ENV=test
#   DATABASE_URL=postgresql://<user>:<password>@localhost:5432/video_management_app_test
# The test database name must end in _test.
